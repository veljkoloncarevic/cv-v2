# Copy to .env and fill in before `docker compose up -d`.

# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-64-hex-chars

# Used for canonical URLs, sitemap.xml and JSON-LD absolute image URLs.
SITE_URL=https://www.veljkoloncarevic.in.rs

# Keep 1 in production (TLS). Set 0 only for plain-http localhost testing,
# otherwise the admin session cookie will not be sent and login will loop.
COOKIE_SECURE=1
